# ---- Database -------------------------------------------------------------
# Local prototype (default): SQLite file via Node's built-in node:sqlite
DATABASE_URL=sqlite:./data/jobhunter.db
# Production (docker-compose.yml builds DATABASE_URL itself from POSTGRES_PASSWORD):
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgres://user:password@host:5432/jobhunter

# ---- Dashboard authentication (REQUIRED in production) ---------------------
# Single-user password and a long random secret used to sign session cookies.
#   openssl rand -hex 32
DASHBOARD_PASSWORD=
AUTH_SECRET=

# Public URL used for dashboard links in emails
APP_BASE_URL=http://localhost:3000

# ---- Email (optional) --------------------------------------------------------
# outbox = write previews to ./data/outbox (default, sends nothing)
# smtp   = real delivery through SMTP
# resend = real delivery through the Resend HTTP API
EMAIL_PROVIDER=outbox
EMAIL_FROM="Job Hunter <jobs@example.com>"
EMAIL_TO=you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=

# NOTE: there is no LLM/AI integration. Scoring and explanations are fully deterministic and no CV or
# profile data is ever sent to an external AI service.

# ---- Worker ------------------------------------------------------------------
# How often the worker checks whether a scheduled run is due (seconds)
WORKER_TICK_SECONDS=30
